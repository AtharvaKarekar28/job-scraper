{
  "_comment": "All patterns are case-insensitive Python regexes. Edit this file to retune the feed; the scraper reads it at run time and no other file needs to change.",

  "role_match": [
    "data analyst",
    "data analytics",
    "operations analyst",
    "business operations analyst",
    "revenue operations analyst",
    "growth operations analyst",
    "strategy (?:&|and) operations analyst",
    "research analyst",
    "business intelligence",
    "\\bbi analyst\\b",
    "data scientist",
    "data science",
    "decision scientist",
    "data engineer",
    "analytics engineer",
    "machine learning engineer",
    "\\bml engineer\\b",
    "quantitative analyst",
    "product analyst",
    "marketing analyst",
    "growth analyst",
    "reporting analyst",
    "insights analyst"
  ],

  "title_exclude": [
    "senior",
    "\\bsr\\.?\\b",
    "staff",
    "principal",
    "\\blead\\b",
    "manager",
    "director",
    "\\bvp\\b",
    "vice president",
    "head of",
    "architect",
    "clearance",
    "ts/sci",
    "\\bsecret\\b",
    "account executive",
    "\\bsales\\b",
    "counsel"
  ],

  "location_exclude": [
    "canada", "toronto", "vancouver", "montreal", "ottawa",
    "united kingdom", ",\\s*uk\\b", "london", "manchester", "edinburgh",
    "ireland", "dublin",
    "india", "bengaluru", "bangalore", "hyderabad", "mumbai", "pune", "gurgaon", "chennai",
    "poland", "warsaw", "krakow", "wroclaw",
    "germany", "berlin", "munich", "hamburg",
    "netherlands", "amsterdam",
    "australia", "sydney", "melbourne",
    "singapore", "japan", "tokyo", "korea", "seoul",
    "israel", "tel aviv",
    "brazil", "s(?:a|ã)o paulo", "mexico", "guadalajara",
    "spain", "madrid", "barcelona",
    "france", "paris", "portugal", "lisbon", "porto",
    "italy", "milan", "rome",
    "switzerland", "zurich", "geneva",
    "sweden", "stockholm", "denmark", "copenhagen", "norway", "oslo", "finland", "helsinki",
    "china", "shanghai", "beijing", "hong kong", "taiwan", "taipei",
    "philippines", "manila", "vietnam", "thailand", "indonesia", "malaysia",
    "costa rica", "colombia", "bogot", "argentina", "chile", "peru",
    "romania", "bucharest", "czech", "prague", "hungary", "budapest",
    "austria", "vienna", "belgium", "brussels",
    "dubai", "\\buae\\b", "abu dhabi",
    "new zealand", "auckland",
    "south africa", "nigeria", "kenya", "egypt",
    "\\bemea\\b", "\\bapac\\b", "\\blatam\\b", "europe"
  ],

  "internship_match": [
    "\\bintern\\b", "internship", "co-?op", "new ?grad", "university",
    "campus", "early career", "apprentice", "\\(20\\d\\d\\)"
  ],

  "sponsorship_negative": [
    "will not sponsor",
    "unable to sponsor",
    "not able to sponsor",
    "cannot sponsor",
    "do(?:es)? not (?:offer |provide )?sponsor",
    "no (?:visa )?sponsorship",
    "without (?:visa )?sponsorship",
    "not (?:offer|provide) (?:visa )?sponsorship",
    "must be a (?:us|u\\.s\\.) citizen",
    "us citizenship (?:is )?required",
    "u\\.s\\. citizenship (?:is )?required",
    "green card holder",
    "security clearance",
    "active clearance",
    "ts/sci",
    "public trust clearance"
  ],

  "max_years_experience": 2,

  "_max_years_note": "A posting is kept when the lowest years-of-experience figure in its description is at or below this number. Postings that never state a number are kept and tagged 'unverified'.",

  "max_posting_age_days": null,

  "_max_age_note": "Set to a number (e.g. 365) to drop postings older than that. Off by default. Some boards leave evergreen requisitions open for years -- Palantir has live postings first published in 2020 -- but a genuinely open role can also sit unfilled for a long time, so this discards real jobs as well as stale ones. The site always shows the year on anything not posted this year, so you can judge without turning this on.",

  "new_job_window_days": 3
}
